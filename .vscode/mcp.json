{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/absolute/path/to/ms-playwright"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@github/mcp@latest"
      ]
    }
  }
}